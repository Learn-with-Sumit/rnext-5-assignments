				{
					"name": "Remove Bookmark (Explicit Delete)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/events/{{eventId}}/bookmark",
							"host": ["{{baseUrl}}"],
							"path": ["api", "events", "{{eventId}}", "bookmark"]
						},
						"description": "Remove an event bookmark explicitly."
					},
					"response": []

		{
			"name": "06. Speakers",
			"item": [
				{
					"name": "Get Speakers (All or by Event)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/speakers?event_id={{eventId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "speakers"],
							"query": [
								{
									"key": "event_id",
									"value": "{{eventId}}",
									"description": "Filter speakers for a specific event"
								}
